# 掌心窗 server 配置
# 生成 token 示例：python3 - <<'PY'
# import secrets; print(secrets.token_urlsafe(32))
# PY
LINJIAN_TOKEN=please-change-me-to-a-long-random-token
LINJIAN_URL=http://127.0.0.1:8513
LINJIAN_HOST=127.0.0.1
LINJIAN_PORT=8513
LINJIAN_DATA_DIR=./data
LINJIAN_KEEP=3
LINJIAN_HOOK=

# Shared memory is off by default. Values below are placeholders only.
MEMORY_ENABLED=false
DATABASE_URL=postgresql://test-user:test-password@127.0.0.1:5432/test-db
MEMORY_CREDENTIAL_PEPPER=replace-with-random-pepper
MEMORY_BOOTSTRAP_READER_TOKEN=replace-with-random-reader-token
MEMORY_BOOTSTRAP_WRITER_TOKEN=replace-with-random-writer-token
