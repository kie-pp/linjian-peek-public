LINJIAN_URL=https://example.invalid
LINJIAN_TOKEN=replace-with-existing-linjian-token

# Shared-memory tools remain absent from the public /mcp endpoint.
# Both flags and complete OAuth resource-server configuration are required for /mcp-memory.
MEMORY_MCP_TOOLS_ENABLED=false
MEMORY_MCP_ENDPOINT_ENABLED=false
MEMORY_MCP_WRITER_TOKEN=replace-with-random-writer-token
MEMORY_MCP_OAUTH_ISSUER=https://your-tenant.auth0.com/
MEMORY_MCP_OAUTH_AUDIENCE=https://your-mcp.example.invalid/mcp-memory
MEMORY_MCP_OAUTH_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json
MEMORY_MCP_OAUTH_RESOURCE=https://your-mcp.example.invalid/mcp-memory
MEMORY_MCP_OAUTH_ALLOWED_SUBJECTS=provider-user-id-placeholder
